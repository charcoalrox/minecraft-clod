{
  "multipart": [
    {
      "when": { "up": "true" },
      "apply": { "model": "the-clod:block/bouncy_castle_wall_post_magenta" }
    },
    {
      "when": { "north": "low" },
      "apply": { "model": "the-clod:block/bouncy_castle_wall_side_magenta", "uvlock": true }
    },
    {
      "when": { "east": "low" },
      "apply": { "model": "the-clod:block/bouncy_castle_wall_side_magenta", "y": 90, "uvlock": true }
    },
    {
      "when": { "south": "low" },
      "apply": { "model": "the-clod:block/bouncy_castle_wall_side_magenta", "y": 180, "uvlock": true }
    },
    {
      "when": { "west": "low" },
      "apply": { "model": "the-clod:block/bouncy_castle_wall_side_magenta", "y": 270, "uvlock": true }
    },
    {
      "when": { "north": "tall" },
      "apply": { "model": "the-clod:block/bouncy_castle_wall_side_magenta", "uvlock": true }
    },
    {
      "when": { "east": "tall" },
      "apply": { "model": "the-clod:block/bouncy_castle_wall_side_magenta", "y": 90, "uvlock": true }
    },
    {
      "when": { "south": "tall" },
      "apply": { "model": "the-clod:block/bouncy_castle_wall_side_magenta", "y": 180, "uvlock": true }
    },
    {
      "when": { "west": "tall" },
      "apply": { "model": "the-clod:block/bouncy_castle_wall_side_magenta", "y": 270, "uvlock": true }
    }
  ]
}